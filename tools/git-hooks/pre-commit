#!/bin/sh
# pre-commit — THE GREEN GUARD at the commit (GitHub #290, ruled 2026-10-16, 14z-203): refuse a commit whose tree
# (the index) has no strict GREEN run of the whole static tier with ROMDIR set. Installed by tools/install_hooks.sh;
# the logic and its rules: tools/git-hooks/green_guard.py; tested by tests/test_green_guard.sh.
REPO="$(git rev-parse --show-toplevel)"
exec python3 "$REPO/tools/git-hooks/green_guard.py" check-commit
