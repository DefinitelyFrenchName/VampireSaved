+// ── CPS-2 WIDE v1 (Vampire Saved project; docs/cps2_wide.md) ───────────
+// Rule 1 v2: emulator changes are permitted only inside a named, versioned,
+// PROFILE-GATED hardware profile. This config is the gate — it is reached
+// only from the vsavjw driver entry, so stock vsavj and every other CPS-2
+// game are untouched by construction.
+//
+// The flag is set here, at machine-config time, which is strictly earlier
+// than any device start, so it is live before the first sprite is drawn and
+// there is no init-order question to reason about.
+void cps2_state::cps2wide(machine_config &config)
+{
+	cps2(config);
+
+	m_cps2_wide = true;
+	// TEST-ONLY positive control (B4). Off by default; never set in a
+	// shipped build. Read here rather than at draw time so the whole run
+	// uses one consistent value.
+	m_cps2_wide_canary = (getenv("CPS2_WIDE_CANARY") != nullptr);
+
+	m_maincpu->set_addrmap(AS_PROGRAM, &cps2_state::cps2_wide_map);
+	m_maincpu->set_addrmap(AS_OPCODES, &cps2_state::decrypted_opcodes_wide_map);
+}
