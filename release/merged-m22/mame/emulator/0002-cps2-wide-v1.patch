+	// ── CPS-2 WIDE v1: the 19-bit sprite tile address ──────────────────
+	// The stock address is 16 code bits plus 2 bank bits taken from the
+	// y-word (0x6000): 18 bits, 32MB. WIDE needs a 19th, and y-word bit 15
+	// CANNOT carry it — find_last_sprite() uses bit 15 as the END-OF-LIST
+	// marker, so setting it on a live sprite would truncate the sprite list
+	// (measured, Phase A/A2). Capcom hit the same wall on CPS-2 Turbo and
+	// solved it by promoting bit 12 into bit 15 AFTER the list has been
+	// walked; WIDE adopts that rule verbatim rather than inventing an
+	// encoding. Phase A confirmed vanilla vsav never sets bit 12 on a live
+	// sprite, so this is inert for stock content.
+	// This is the profile's ONLY change to emulation logic. Everything else
+	// is descriptor table data. See docs/cps2_wide.md.
+	int cps2_wide_bankbits(int y) const
+	{
+		if (m_cps2_wide_canary && (y & 0x4000))
+			y = (y & ~0x4000) | 0x1000;   // TEST-ONLY: banks 2/3 -> WIDE 4/5
+		if (y & 0x1000)
+			y |= 0x8000;                  // bit 12 -> bit 15
+		return y & 0xe000;                // 19 bits once shifted left by 3
+	}
