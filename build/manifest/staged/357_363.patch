+region_space = "x101aca=wide_ext,x06e1d2=wide_ext,x1d7428=wide_ext,x090eda=wide_ext,x0d1bbe=wide_ext"   # 14z-219: #356's speed-line copy and #345 A1b's table copy (WIDE-only roots); 14z-221c: #357's guard-orb watcher
 
 # free-space holes (verified 0xFF fill, tools/extract free-space scan)
 [hole_a]
@@ -3400,3 +3400,39 @@ old_hex = "004c"
 new_hex = "4e71"
 only_variant_slot = true
 note = "#195 (14z-188): the displaced move.l's last word -> nop; pairs with pursuit_mark_tail"
+
+# ── #357 (14z-221c, ruled 2026-11-05: "we should port the orbs unless we find out we technically cannot") ──────────
+# DONOVAN'S GUARD ORBS. At his guard native vs2 draws eight small red orbs (effect type 0x72 sub 0x16) around the
+# fighters for about 14 frames; ours drew none. They are spawned by a WATCHER, a type-0x13 object of the $FFD400 pool
+# that his set-up creates once per round (vs2 0x05AE3C, ported as PRG:0x0C104C): its handler (vs2 PRG:0x090EDA, the
+# x090eda root in tools/build_donovan.sh) follows him and, when byte +$0B of his current anim-frame record turns
+# positive, spawns the eight orbs. vsavj's row 0x13 of that pool's 38-row table (PRG:0x080AAC + 19*4 = 0x080AF8) is the
+# bare-rts stub every unfilled row shares, so ours created the watcher and dispatched it into the stub
+# (docs/game/engine_internals.md «Donovan's guard orbs»). One table-row write points it at the ported handler, as
+# Huitzil's row 16 (beam_effect_class16) — safe only because vanilla never reads row 19: measured by
+# tests/audit_effect_class_rows.sh section 1b against the row-37 control. `old_hex` pins the stub. WIDE-only: the
+# region is placed in wide_ext, so the row is skipped on the stock profile.
+[[code_ptr]]
+stage = 4
+profile = "cps2-wide-v1"
+name = "guard_orb_class19"
+addr = 0x080AF8
+old_hex = "00080b44"
+region = "x090eda:0x0"
+note = "effect-class row 19 (0x13) -> the ported vs2 type-0x13 guard-orb watcher (#357)"
+
+# #357's motion table (14z-221c). The orbs move by vs2's class-0x72 sub-0x16 code in his x088512 copy (vs2 PRG:0x089442
+# / 0x0894A4: y += word 2(a1, 4*index) >> 6, a1 = `movea.l #$0D1BBE` at vs2 PRG:0x089484, its operand x088512+0xF74), a
+# 64-entry cos/sin table 0x0D1BBE-0x0D1CBD. That target resolved into his hitbox_proj copy (vs2 0x0D0CA8, capped at
+# 0x1000 by tools/extract_char.py), which ends at 0x0D1CA7, so entries 0x3A-0x3F read the next allocation (ours
+# PRG:0x0CB800, an alloc wrapper): on the scratch build one orb of a guard event took y += 0xFB (0x006F -> 0x016A at
+# f2798 on donovan_15, native 0x0070). Nothing reached those entries before the orbs. The operand is pinned to a whole
+# WIDE-only copy of the table (the x0d1bbe root); hitbox_proj itself is untouched.
+[[ref_pin]]
+stage = 6
+region = "x088512"
+off = 0xF74
+target = 0x0D1BBE
+pin_region = "x0d1bbe:0x0"
+only_variant_slot = true
+note = "#357: the orbs' motion table -> the whole copy (x0d1bbe), not hitbox_proj's truncated tail"
diff --git a/build/manifest/huitzil.toml b/build/manifest/huitzil.toml
index c409b023..3909ae80 100644
--- a/build/manifest/huitzil.toml
+++ b/build/manifest/huitzil.toml
@@ -3105,3 +3105,41 @@ old_hex = "3b49b48e"
 new_hex = "3b49b43c"
 note = "#157: grab ptr store a1 (site 3)"
 
+
+# ── #363 (14z-221c; the maintainer chose "Fix it too (Recommended)" for #363 on 2026-11-05): THE FREEZE REACTION ────
+# Phobos's Plasma Beam (ES) hits with reaction class 0x4F. vs2's victim reaction table (vs2 0x022388) sends row 0x4F to
+# 0x02296C, the FREEZE: sub 08, +0x140 = 0x14, +0x11E cleared, +0x5C = 0x1F (the freeze timer, counted down each frame:
+# 0x1F, 0x1D, 0x1C ... on native, build/agent221c/t363/base/native.st), the anim byte 0x1B, then the ice-block spawn —
+# the maintainer, on 14z-221b's capture: "vs2 always freezes (not paralyses: the whole ice block effect) Demitri on each
+# hit". vsavj's table (PRG:0x02385C, 80 16-bit rows read by `move.w $2385c(pc,d0.w),d1 / jmp $2385c(pc,d1.w)` at
+# PRG:0x023854) sends rows 0x4E and 0x4F to its default row 0x0238FC, the pushback slide: ours slid Demitri +81 px.
+# vsavj carries the same freeze for class 0x14 (PRG:0x023D82: sub 08, +0x140 = 0x14, +0x11E = 1, its anim byte from
+# the class map, `bsr 0x27EC0`, `jmp 0x060ED8` — the twins of vs2's 0x027114 and 0x06D31C), but not the class-0x4F
+# special case (+0x11E = 0, +0x5C = 0x1F), and vsavj's class map (data PRG:0x028D00) holds 0x00 at 0x4F where vs2's
+# (0x027FD8) holds 0x1B; without +0x5C the freeze would end at once. So the handler is authored: vs2's 0x02296C with
+# vsavj's twins, the map byte as an immediate (`move.b #$1b,d0` leaves d0's upper bits as vs2's `move.b` does).
+# THE ROW IS 16 BITS, so the handler must be reached from within +-32K of the table: the jump sits on the six dead
+# bytes PRG:0x029CBA-0x029CBF (`move.b #4,$3B5(a6)`, an unreferenced entry fragment ending `bra.b 0x029C74`):
+# tools/audit_dead_span.py DEAD (refs A 0 C 0 T 0, fenced) and tests/audit_dead_span_exec.sh 0 executions there and at
+# its `bra.b` 0x029CC0 over the 64-replay legacy corpus (14z-221c). The first candidate, 0x0236CE, was REJECTED: the
+# tool called it dead, but it is entries 10-15 of a 16-byte table read by `move.b $236c4(pc,d0.w),d0` after
+# `andi.w #$f,d0` at PRG:0x023694 (docs/project/gotchas.md). Row 0x4F's deadness in vanilla: tests/audit_effect_class_rows.sh
+# section 1c. Row 0x4E (vs2 0x0226E0, a different handler) is not ported: no move measured to carry it.
+[[code_word]]
+stage = 6
+name = "freeze_reaction_row4f"
+addr = 0x0238FA
+old_hex = "00a0"
+new_hex = "645e"
+# 0x0238FC - 0x02385C = 0x00A0 (the default row); 0x029CBA - 0x02385C = 0x645E (the jump below)
+
+[[site_thunk]]
+stage = 6
+name = "freeze_reaction_4f"
+site = 0x029CBA
+old_hex = "1d7c000403b5"
+patch = "jmp"
+rts_ok = true
+# move.b #8,$7(a6) / move.b #$14,$140(a6) / clr.b $11e(a6) / move.b #$1f,$5c(a6) / move.b #$1b,d0 /
+# jsr $27ec0.l / jmp $60ed8.l   (vs2 0x02296C-0x0229A5; the jmp's target rts's to the dispatch's caller, as every row does)
+thunk_hex = "1d7c000800071d7c00140140422e011e1d7c001f005c103c001b4eb900027ec04ef900060ed8"
