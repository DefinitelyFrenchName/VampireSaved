+# ── #182 (14z-185): PHOBOS'S AIR-BLOCK GUARD WINDOW — vs2's own id-0x10 branch at vsavj's block entry ──
+# vs2's block entry (0x022480) sends fighter id 0x10 to 0x0224C4, which sets the guard window +0x158 := 0x0E and
+# +0x1AB := 0x0E BEFORE the airborne test, so natively Phobos can guard cancel (Reflect Wall, his check vs2 0x055470,
+# ported at 0x414920: `tst.b $158(a6); beq fail`) from an AIR block; vsavj's block entry (0x02393A) never opens it in
+# the air, and vsav's original characters have no air guard cancel (tests/audit_air_gc_legacy.sh; the maintainer,
+# 14z-185: the air guard cancel is Phobos's alone). The thunk replaces vsavj's first store (`move.b #$12,$140(a6)`,
+# 6 bytes) and, for TT only, writes vs2's two stores, then returns to 0x023940:
+#   move.b #$12,$140(a6); cmpi.b #TT,$382(a6); bne.s +12; move.b #$e,$158(a6); move.b #$e,$1ab(a6); jmp $023940
+# Every character's block passes through it (the original store, one compare, one branch). Measured before
+# building, on Probe A (this row in a copy of this file): Phobos matches native vs2 on 540/540 traced frames of both
+# air-block events of tests/replays/chains174/huitzil_c174, with and without the guard cancel; the merged legacy
+# oracle identical to merged-m20 on all 53 replays while 171 legacy block entries ran through the thunk; the
+# maintainer read the capture ("Same, confirmed") and ruled "Design A" (DECISIONS_HISTORY.md, 14z-185). The vs2
+# Dark Force air-GC glitch (Mizuumi) is vs2's P+K Dark Force Power's (the maintainer, 14z-185: "P+K Power"); on our
+# build P+K is vsav's Dark Force Change (ruled 14z-168; Phobos's enters his flight form, tests/audit_df_modes.sh),
+# so the Power the glitch is reported in is not reachable here — our reading, not a ruling.
+# docs/game/engine_internals.md "THE GUARD WINDOW ON AN AIR BLOCK".
+[[site_thunk]]
+stage = 4
+name = "air_block_guard_window"
+site = 0x02393A
+old_hex = "1d7c00120140"
+patch = "jmp"
+jmp_ok = true
+thunk_hex = "1d7c001201400c2e00TT0382660c1d7c000e01581d7c000e01ab4ef900023940"
