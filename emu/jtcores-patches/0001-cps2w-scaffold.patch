diff --git a/cores/cps2w/README.md b/cores/cps2w/README.md
new file mode 100644
index 000000000..240e58c17
--- /dev/null
+++ b/cores/cps2w/README.md
@@ -0,0 +1,16 @@
+# jtcps2w — CPS-2 WIDE (Vampire Saved) core
+
+A SEPARATE core next to `cores/cps2`, so the reference CPS-2 core stays
+untouched and separately usable. It is the MiSTer target of the
+**Vampire Saved** project (full-roster Vampire Savior on the real CPS-2
+engine): https://github.com/DefinitelyFrenchName/VampireSaved
+
+Status: SCAFFOLD. `cfg/` is a twin of `cores/cps2/cfg` with only
+`CORENAME=JTCPS2W` changed and the MRA set restricted to the Vampire
+Savior family (the stock reference leg — the patched core running the
+unmodified game must behave exactly as `jtcps2` does). No RTL differs
+yet; every RTL change that follows is profile-gated and documented in the
+Vampire Saved repository (`docs/platform/mister.md`,
+`docs/project/cps2_wide.md`).
+
+Licence: GPL-3.0, as jtcores. See the repository LICENSE.
diff --git a/cores/cps2w/cfg/game.yaml b/cores/cps2w/cfg/game.yaml
new file mode 100644
index 000000000..6271ac102
--- /dev/null
+++ b/cores/cps2w/cfg/game.yaml
@@ -0,0 +1,31 @@
+game:
+  - from: cps2
+    get:
+      - jtcps2_game.v
+      - jtcps2_main.v
+      - jtcps2_obj.v
+      - jtcps2_objram.v
+      - jtcps2_obj_frame.v
+      - jtcps2_obj_scan.v
+      - jtcps2_colmix.v
+      - jtcps2_raster.v
+      - jtcps2_dtack.v
+        # Encryption
+      - jtcps2_keyload.v
+      - jtcps2_decrypt.v
+      - jtcps2_fn1.v
+      - jtcps2_fn2.v
+      - jtcps2_fn_sbox.v
+      - jtcps2_sbox.v
+      - jtcps2_dec_ctrl.v
+  - from: cps1
+    get:
+      - common.yaml
+  - from: cps15
+    get:
+      - qsound.yaml
+jtframe:
+  - from: ram
+    get:
+      - jtframe_dual_ram16.v
+
diff --git a/cores/cps2w/cfg/macros.def b/cores/cps2w/cfg/macros.def
new file mode 100644
index 000000000..635032158
--- /dev/null
+++ b/cores/cps2w/cfg/macros.def
@@ -0,0 +1,30 @@
+include ../../cps1/cfg/common.def
+
+CPS2
+GAMETOP=jtcps2_game
+CORENAME=JTCPS2W
+JTFRAME_SDRAM_LARGE
+
+# OSD options
+CORE_OSD+=O7,1P_hold_for_slow,Off,On;
+# CPS1.5 games don't have DIP switches
+# but use NVRAM instead
+JTFRAME_OSD_TEST
+JTFRAME_DIPBASE=16
+JTFRAME_DIAL
+JTFRAME_IOCTL_RD=128
+CPS1_NOOBJ
+JTFRAME_HEADER=44
+
+[mist|sidi]
+# Not enough BRAM to show the credits
+JTFRAME_OSD_NOLOGO
+# Not enough BRAM for the interpolator
+NOFIR
+
+[mister|pocket]
+JTFRAME_CREDITS
+JTFRAME_CREDITS_NOROTATE
+
+[mister]
+JTFRAME_MR_DDRLOAD
