+// ---------------------------------------------------------------------------
+// CPS-2 WIDE (Vampire Saved) OVERRIDE of cores/cps2/hdl/jtcps2_obj.v.
+// SLICE D3. Copied at jtcores v1.7.3 for one reason only: the object GFX bank
+// is three bits wide once the promote in jtcps2_obj_scan is live, so the wire
+// that carries it from the scanner to the drawer and the port that carries it
+// out to jtcps1_sdram both have to widen. `wide_en` passes through to the
+// scanner, which is where the promote is gated. No other behaviour changes.
+// ---------------------------------------------------------------------------
+
+module jtcps2_obj(
+    input              rst,
+    input              clk,
+    input              clk_cpu,
+    input              pxl_cen,
+    input              flip,
+    input              wide_en,     // CPS-2 WIDE profile (jtcps2w_profile.v)
+    input              LVBL,
+
+    // Configuration
+    input              objcfg_cs,
+    input      [15:0]  cpu_dout,
+    input      [ 1:0]  dsn,
+    input      [ 3:1]  addr,
+
+    // Interface with SDRAM for ORAM data
+    output     [12:0]  oram_addr,
+    input              oram_ok,
+    output             oram_clr,
+    output             oram_cs,
+    input      [15:0]  oram_data,
+
+    input              obank,
+
+    input              start,
+    input      [ 8:0]  vrender1,  // 1 line  ahead of vdump
+    input      [ 8:0]  vdump,
+    input      [ 8:0]  hdump,
+
+    output     [19:0]  rom_addr,    // up to 1 MB
+    output     [ 2:0]  rom_bank,
+    output             rom_half,    // selects which half to read
+    input      [31:0]  rom_data,
+    output             rom_cs,
+    input              rom_ok,
+
+    output     [11:0]  pxl
+);
+
+wire [15:0] dr_code, dr_attr;
+wire [ 8:0] dr_hpos;
+wire [ 2:0] dr_prio, buf_prio;
+wire [ 2:0] dr_bank;
+
+wire        dr_start, dr_idle;
+
+wire [15:0] line_data;
+wire [ 8:0] line_addr;
+
+wire [ 8:0] hdump_dly;
+
+wire [ 8:0] buf_addr, buf_data;
+wire [11:0] prio_data;
+wire        buf_wr;
+
+wire [ 9:0] off_x, off_y;
+
+wire        obank_frame, oframe_we, line;
+
+// shadow RAM interface
+wire [ 9:0] table_attr;
+wire [15:0] obj_x, obj_y, obj_code, obj_attr;
+
+assign prio_data = { buf_prio, buf_data };
+
+jtcps2_obj_frame u_frame(
+    .rst        ( rst           ),
+    .clk        ( clk           ),
