From 6c32be8dda0ed7bc10ad6a0b168c7da2227a6945 Mon Sep 17 00:00:00 2001
From: Chaton <definitelyfrenchname@gmail.com>
Date: Sun, 23 Aug 2026 09:13:28 +0200
Subject: [PATCH] jtframe/sim: the Verilator SDRAM model drops the top address
 bit at AW=23

At JTFRAME_SDRAM_LARGE (SDRAMW=23, the 64MB tier) the C++ SDRAM model in
hdl/ver/test.cpp decodes only 22 of the 23 address bits, so the upper 8MB
of every bank aliases onto the lower 8MB -- silently, and including during
the ROM download, so the aliased half is never even written.

The controller's mapping is unusual and that is what the model missed.
jtframe_sdram64_bank.v:

  :75-76  localparam ROW=13, COW= AW==22 ? 9 : 10;
  :127    addr_row = AW==22 ? addr[AW-1:AW-ROW] : addr[AW-2:AW-1-ROW];
  :219    sdram_a[10:0] = { precharge_flag, addr[AW-1], addr[8:0] };

so at AW=23 the word address splits as row = addr[21:9] and column =
{ addr[22], addr[8:0] }. The TOP address bit is column bit 9; addr[9] is a
row bit. test.cpp rebuilt the column from (SDRAM_A & 0x1ff) only, dropping
addr[22]. The naive "widen the column mask to 0x3ff" fix would be wrong for
the same reason.

Fixed by reconstructing bit 22 from sdram_a[9] on the READ/WRITE command,
under #ifdef _JTFRAME_SDRAM_LARGE. LARGE-only is not a convenience: at
AW=22 the same :219 puts addr[AW-1] = addr[21] on sdram_a[9], where it is
already part of addr_row and COW=9 makes it a don't-care, so 32MB-module
cores must keep ignoring it. Their behaviour is byte-for-byte unchanged.
The burst column counter stays 9-bit, also on purpose: SDRAM burst
addressing wraps inside the burst-length-aligned block and never carries
into column bit 9.

No allocation change is needed -- BANK_LEN is already 0x100'0000 (16MB)
under _JTFRAME_SDRAM_LARGE (test.cpp:55-59) and read_bank/write_bank16
already mask with (BANK_LEN>>1)-1 = 0x7fffff.

Measured on jtcps2 running vsavj, which fills banks 2 and 3 to 16MB each:
obj fetches carry the in-bank top bit as rom0_bank[1]
(cores/cps1/hdl/jtcps1_sdram.v:359 `cps2_gfx0 = { rom0_bank[1], gfx0_addr }`),
so before this change every object tile in the upper half of a GFX bank was
drawn from the wrong half of the ROM.

Reported upstream-worthy: this is an upstream jtframe bug, not a fork
artifact, and it affects every JTFRAME_SDRAM_LARGE core simulated under
Verilator. Not filed as an issue/PR from here.
---
 modules/jtframe/hdl/ver/test.cpp | 30 ++++++++++++++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/modules/jtframe/hdl/ver/test.cpp b/modules/jtframe/hdl/ver/test.cpp
index 0901d4103..cec143d8c 100644
--- a/modules/jtframe/hdl/ver/test.cpp
+++ b/modules/jtframe/hdl/ver/test.cpp
@@ -602,12 +602,34 @@ void SDRAM::update() {
             change_burst();
         }
         if( !dut.SDRAM_nRAS && dut.SDRAM_nCAS && dut.SDRAM_nWE ) { // Row address - Activate command
-            ba_addr[ cur_ba ] = dut.SDRAM_A << 9; // 32MB module
+            // row = addr[21:9] on both tiers -- jtframe_sdram64_bank.v:127
+            //   addr_row = AW==22 ? addr[AW-1:AW-ROW] : addr[AW-2:AW-1-ROW]
+            // with ROW=13, so AW=22 -> addr[21:9] and AW=23 -> addr[21:9].
+            ba_addr[ cur_ba ] = dut.SDRAM_A << 9;
             ba_addr[ cur_ba ] &= 0x3fffff;
         }
         if( dut.SDRAM_nRAS && !dut.SDRAM_nCAS ) {
             ba_addr[ cur_ba ] &= ~0x1ff;
             ba_addr[ cur_ba ] |= (dut.SDRAM_A & 0x1ff);
+#ifdef _JTFRAME_SDRAM_LARGE
+            // 64MB tier: the TOP address bit rides on sdram_a[9], and it is
+            // NOT a column bit. jtframe_sdram64_bank.v:75-76 sets COW=10 for
+            // AW=23 and :219 drives
+            //     sdram_a[10:0] = { precharge_flag, addr[AW-1], addr[8:0] }
+            // so the word address is  row=addr[21:9] | col={addr[22],addr[8:0]}
+            // -- addr[22] is column bit 9, NOT addr[9]. Rebuilding only the
+            // low 9 bits (the line above, which is all upstream does) drops
+            // addr[22] and ALIASES the upper 8MB of every bank onto the lower
+            // 8MB, silently, at a tier where each bank is 16MB and BANK_LEN
+            // above already allocates all 16MB.
+            //
+            // LARGE-ONLY BY CONSTRUCTION: at AW=22 the same :219 puts
+            // addr[AW-1] = addr[21] on sdram_a[9], which is already part of
+            // addr_row, and COW=9 makes it a don't-care -- so a 32MB-module
+            // core must keep ignoring it and is byte-for-byte unaffected here.
+            ba_addr[ cur_ba ] &= ~0x400000;
+            ba_addr[ cur_ba ] |= (dut.SDRAM_A & 0x200) << 13; // 0x200<<13 == 1<<22
+#endif
             if( dut.SDRAM_nWE ) { // enque read
                 rd_st[ cur_ba ] = burst_len+1;
             } else {
@@ -638,7 +660,11 @@ void SDRAM::update() {
                 //cout << "Read " << std::hex << data_read << " from bank " << k << '\n';
                 dut.SDRAM_DQ = data_read;
                 if( burst_len>1 ) {
-                    // Increase the column within the burst
+                    // Increase the column within the burst. The 9 LOW bits
+                    // only, on both tiers: SDRAM burst addressing wraps inside
+                    // the burst-length-aligned block, so it never carries into
+                    // column bit 9 -- which on the 64MB tier is addr[22], the
+                    // bit reconstructed above and not part of the counter.
                     auto col = ba_addr[k]&0x1ff;
                     auto col_inc = (col+1) & ~burst_mask;
                     col &= burst_mask;
-- 
