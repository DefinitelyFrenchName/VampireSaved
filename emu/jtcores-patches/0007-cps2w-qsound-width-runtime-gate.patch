+++ b/cores/cps2w/cfg/game.yaml
@@ -1,7 +1,35 @@
+# jtcps2w — the CPS-2 WIDE (Vampire Saved) file list.
+#
+# THIS FILE IS NO LONGER cores/cps2/cfg/game.yaml VERBATIM, and the delta IS
+# the core's trust surface. Since slice D1 (14z-107) cps2w carries RTL: a file
+# is copied into cores/cps2w/hdl ONLY when it must differ, and it is then
+# pulled from `cps2w` here and REMOVED from the reference core's list, because
+# jtframe deduplicates by full path and would otherwise compile both copies of
+# the same module. Everything else still resolves to cores/cps2, cores/cps1
+# and cores/cps15, which stay BYTE-UNTOUCHED.
+#
+# THE OVERRIDES, and why each one has to differ (docs/project/mister_map.md):
+#   jtcps2_game.v    — the game top: 24-bit qsnd_addr, the profile gate
+#                      instance, wide_en routed to the sound block.
+#   jtcps15_sound.v  — the QSound block: 24-bit qsnd_addr and the sample-bank
+#                      latch replaced by the gated jtcps2w_qsnd_bank.
+# THE NEW FILES:
+#   jtcps2w_profile.v    — decodes the CPS-2 WIDE bit out of the ROM header.
+#   jtcps2w_qsnd_bank.v  — the gated sample-bank latch (the D1 trust surface).
+#
+# The `qsound.yaml` block below is cores/cps15/cfg/qsound.yaml INLINED minus
+# jtcps15_sound.v: that yaml pulls the shared file, so cps2w cannot include it
+# and override the file at the same time. Keep the two in step by hand if the
+# pin ever moves; tests/test_jtcores_twin.sh freezes this list.
 game:
+  - from: cps2w
+    get:
+      - jtcps2_game.v          # OVERRIDE of cores/cps2/hdl
+      - jtcps15_sound.v        # OVERRIDE of cores/cps15/hdl
+      - jtcps2w_profile.v      # new
+      - jtcps2w_qsnd_bank.v    # new
   - from: cps2
     get:
-      - jtcps2_game.v
       - jtcps2_main.v
       - jtcps2_obj.v
       - jtcps2_objram.v
@@ -21,11 +49,18 @@ game:
   - from: cps1
     get:
       - common.yaml
-  - from: cps15
-    get:
-      - qsound.yaml
 jtframe:
   - from: ram
     get:
       - jtframe_dual_ram16.v
-
+  # --- from cores/cps15/cfg/qsound.yaml, minus the overridden game file ---
+  - from: cpu
+    get:
+      - jtframe_kabuki.v
+  - from: sound
+    get:
+      - jtframe_fir.v
+      - jtframe_uprate2_fir.v
+modules:
+  jt:
+    - name: jtdsp16
diff --git a/cores/cps2w/cfg/mame2mra.toml b/cores/cps2w/cfg/mame2mra.toml
index 9d1b3066d..9d607a50e 100644
--- a/cores/cps2w/cfg/mame2mra.toml
+++ b/cores/cps2w/cfg/mame2mra.toml
@@ -85,6 +85,30 @@ data=[
     # Spinner games:
     { machine="pzloop2",  offset=40, data="fd" },
     { machine="ecofghtr", offset=40, data="fe" },
+
+    # ── CPS-2 WIDE v1: THE RUNTIME PROFILE BIT (14z-107 slice D1) ─────────
+    # docs/project/mister_map.md §9 Q8, ruled by the maintainer 2026-08-23:
+    # the profile is selected at RUNTIME from a spare header bit, NOT by an
+    # `ifdef`. The MRA is therefore the profile selector, and stock `vsavj`
+    # on jtcps2w.rbf runs as a stock machine BY CONSTRUCTION — which is what
+    # makes CLAUDE.md rule 1 v2's "profile-gated so stock vsavj is untouched"
+    # a fact on FPGA rather than an inertness argument.
+    #
+    # BYTE 41 (0x29). jtcps1_prom_we.v consumes header bytes 0-7 (region
+    # starts), 8-39 (`is_cps`, the CPS config registers) and 40 (JOY_BYTE);
+    # 41-43 fall through every branch and are ignored, and 44-63 are the
+    # CPS-2 key. The header's own comment (jtcps1_prom_we.v:52-54, "6 are
+    # actually used and 10 are reserved") is the licence to use it.
+    #
+    # ACTIVE LOW, and that is forced, not chosen: `fill=0xff` above means an
+    # unwritten byte is 0xFF, and every stock MRA this core emits must stay
+    # byte-identical to cores/cps2's. Only a polarity where the FILL means
+    # "profile off" can do that. jtframe's own JOY_BYTE is the same shape
+    # (0xFF = mode 3; games wanting mode 0 write 0xFC).
+    #
+    # setname="vsavjw" scores 3 in Selectable.Match, so this row applies to
+    # the WIDE set and to nothing else — no other MRA gains a byte.
+    { setname="vsavjw",   offset=41, data="fe" },
 ]
 
 [rom]
diff --git a/cores/cps2w/hdl/jtcps15_sound.v b/cores/cps2w/hdl/jtcps15_sound.v
new file mode 100644
index 000000000..86bfdb777
--- /dev/null
+++ b/cores/cps2w/hdl/jtcps15_sound.v
@@ -0,0 +1,689 @@
+/*  This file is part of JTCORES1.
+    JTCORES1 program is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
