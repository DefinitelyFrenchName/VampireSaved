diff --git a/src/burner/sdl/harness.cpp b/src/burner/sdl/harness.cpp
new file mode 100644
index 0000000..ec94aa8
--- /dev/null
+++ b/src/burner/sdl/harness.cpp
@@ -0,0 +1,452 @@
+// harness.cpp — Vampire Saved test harness for the SDL2 frontend.
+// FRONTEND-ONLY: no emulation-core file is touched by this feature.
+//
+// Plays a scripted input file (same .rpl format as the MAME-side Lua
+// harness), runs N frames headless (no video/audio interfaces required),
+// checksums CPS-2 work RAM (FNV-1a-64 over 68k-logical byte order) after
+// every frame, and writes a log line-compatible with the MAME harness:
+//     "<frame> <%016llx>\n" ... "END <frames>\n"
+//
+// VIDEO (opt-in, env FBNEO_HVIDEO=<path>): renders each frame into an
+// off-screen buffer and logs a per-frame FRAMEBUFFER checksum. Default
+// stays pBurnDraw=NULL so every existing log and frozen expectation is
+// unchanged. This exists because the RAM checksum is BLIND to the whole
+// video path -- a rendering change (e.g. the CPS-2 WIDE 19-bit sprite
+// tile address) is invisible to it, so a RAM-only gate would "pass" a
+// build whose graphics were broken.
+//
+// Activated by:  fbneo <set> -hinput <script.rpl> -hout <log> [-hframes N]
+// See tools/run_replay_fbneo.sh in the Vampire Saved repo.
+
+#include "burner.h"
+// Public 68k interface: SekMapHandler / SekSetWrite*Handler / SekGetPC.
+// Including a public CPU *interface header* is not modifying an emulation
+// core file — no core source is touched by this feature (Rule 1).
+#include "m68000_intf.h"
+
+INT32 nHarnessTailFrames = 120;        // extra frames after last scripted input
+char szHarnessInput[MAX_PATH] = "";    // replay script path
+char szHarnessOut[MAX_PATH] = "";      // checksum log path
+char szHarnessDumps[8192] = "";         // "2900:ff8000-ff8700;..." RAM dumps
+INT32 nHarnessFrames = 0;              // explicit total override (0 = auto)
+
+extern UINT8* CpsRamFF;                // CPS-2 work RAM (cps.h)
+extern UINT8* CpsRam708;               // OBJ RAM  ($708000-$709FFF)
+extern UINT8* CpsRam90;                // palette / gfx RAM ($900000-$92FFFF)
+extern UINT8* CpsGfx; extern UINT32 nCpsGfxLen;   // decoded tile buffer
+extern int InputMake(bool bCopy);
+
+static UINT32 nHarnessFrame = 0;       // current frame, for instrument logs
+
+// ── 68k address -> host byte pointer (B5b) ───────────────────────────────────
+// The dump/poke instruments originally reached work RAM only. Resolving the
+// address instead lets them reach OBJ RAM and palette RAM too, which is what
+// the venue-asset work actually needs.
+//
+// BYTE ORDER: FBNeo stores these buffers with the 68k-logical byte at index
+// (offset ^ 1) — the SEK little-endian storage convention. Every accessor
+// here applies that swap, so callers always speak 68k-logical addresses,
+// exactly like the MAME-side Lua instruments. This is the repo's #1 gotcha
+// (docs/GOTCHAS.md); getting it wrong here would silently mis-report every
+// byte rather than fail loudly.
+static UINT8* harness_mem(UINT32 a)
+{
+    if (a >= 0xFF0000 && a <= 0xFFFFFF && CpsRamFF)
+        return &CpsRamFF[((a - 0xFF0000) & 0xFFFF) ^ 1];
+    if (a >= 0x708000 && a <= 0x709FFF && CpsRam708)
+        return &CpsRam708[((a - 0x708000) & 0x1FFF) ^ 1];
+    if (a >= 0x900000 && a <= 0x92FFFF && CpsRam90)
+        return &CpsRam90[((a - 0x900000) & 0x3FFFF) ^ 1];
+    return NULL;
+}
+
+// ── input resolution ─────────────────────────────────────────────────────────
+// .rpl tokens -> BurnInputInfo szInfo names (CPS-2 fighting layout)
+
+struct TokenMap { const char* token; const char* szInfo; };
+static const TokenMap TOKENS[] = {
+    { "p1.U", "p1 up" },    { "p1.D", "p1 down" }, { "p1.L", "p1 left" },
+    { "p1.R", "p1 right" }, { "p1.1", "p1 fire 1" }, { "p1.2", "p1 fire 2" },
+    { "p1.3", "p1 fire 3" }, { "p1.4", "p1 fire 4" }, { "p1.5", "p1 fire 5" },
+    { "p1.6", "p1 fire 6" },
+    { "p2.U", "p2 up" },    { "p2.D", "p2 down" }, { "p2.L", "p2 left" },
+    { "p2.R", "p2 right" }, { "p2.1", "p2 fire 1" }, { "p2.2", "p2 fire 2" },
+    { "p2.3", "p2 fire 3" }, { "p2.4", "p2 fire 4" }, { "p2.5", "p2 fire 5" },
+    { "p2.6", "p2 fire 6" },
+    { "sys.S1", "p1 start" }, { "sys.S2", "p2 start" },
+    { "sys.C1", "p1 coin" },  { "sys.C2", "p2 coin" },
+    { "sys.SV", "service" },  { "sys.TS", "diag" },
+};
+static const int NTOKENS = sizeof(TOKENS) / sizeof(TOKENS[0]);
+
+static UINT8* token_pval[NTOKENS];
+
+static int resolve_inputs()
+{
+    for (int t = 0; t < NTOKENS; t++) token_pval[t] = NULL;
+    struct BurnInputInfo bii;
+    for (UINT32 i = 0; i < nGameInpCount; i++) {
+        memset(&bii, 0, sizeof(bii));
+        if (BurnDrvGetInputInfo(&bii, i)) continue;
+        if (!bii.pVal || !bii.szInfo || bii.nType != BIT_DIGITAL) continue;
+        for (int t = 0; t < NTOKENS; t++)
+            if (!strcmp(bii.szInfo, TOKENS[t].szInfo)) token_pval[t] = bii.pVal;
+    }
+    for (int t = 0; t < NTOKENS; t++)
+        if (!token_pval[t]) {
+            printf("harness: input '%s' (%s) not found in driver\n",
+                   TOKENS[t].token, TOKENS[t].szInfo);
+            return 1;
+        }
+    return 0;
+}
+
+static int token_index(const char* who, const char* tok)
+{
+    char key[16];
+    snprintf(key, sizeof(key), "%s.%s", who, tok);
+    for (int t = 0; t < NTOKENS; t++)
+        if (!strcmp(key, TOKENS[t].token)) return t;
+    return -1;
+}
+
+// ── script parsing ───────────────────────────────────────────────────────────
+// held[frame] = bitmask over TOKENS (NTOKENS <= 32)
+
+static UINT32* held = NULL;
+static UINT32 nScriptFrames = 0;
+
+static int parse_script(const char* path)
+{
+    FILE* f = fopen(path, "r");
+    if (!f) { printf("harness: cannot open %s\n", path); return 1; }
+
+    // pass 1: find last frame
+    char line[512];
+    UINT32 last = 0;
+    while (fgets(line, sizeof(line), f)) {
+        UINT32 a = 0, b = 0;
+        if (sscanf(line, "%u-%u", &a, &b) == 2 || sscanf(line, "%u", &a) == 1) {
+            if (b < a) b = a;
+            if (b > last) last = b;
+        }
+    }
+    nScriptFrames = last + (UINT32)nHarnessTailFrames;
+    if (nHarnessFrames > 0) nScriptFrames = (UINT32)nHarnessFrames;
+    held = (UINT32*)calloc(nScriptFrames + 2, sizeof(UINT32));
+
+    // pass 2: fill masks
+    rewind(f);
+    int lineno = 0;
+    while (fgets(line, sizeof(line), f)) {
+        lineno++;
+        char* hash = strchr(line, '#');
+        if (hash) *hash = 0;
+        char* p = line;
+        while (*p == ' ' || *p == '\t') p++;
+        if (!*p || *p == '\n' || *p == '\r') continue;
+
+        UINT32 a = 0, b = 0;
+        int consumed = 0;
+        if (sscanf(p, "%u-%u%n", &a, &b, &consumed) < 2) {
+            if (sscanf(p, "%u%n", &a, &consumed) < 1) {
+                printf("harness: %s:%d parse error\n", path, lineno);
+                fclose(f); return 1;
+            }
+            b = a;
+        }
+        p += consumed;
+        char spec[64];
+        while (sscanf(p, " %63s%n", spec, &consumed) == 1) {
+            p += consumed;
+            if (!strcmp(spec, "wait")) continue;
+            char* eq = strchr(spec, '=');
+            if (!eq) { printf("harness: %s:%d bad spec '%s'\n", path, lineno, spec); fclose(f); return 1; }
+            *eq = 0;
+            const char* who = spec;
+            const char* toks = eq + 1;
+            int step = strcmp(who, "sys") ? 1 : 2;
+            for (const char* c = toks; *c; c += step) {
+                char tok[3] = { c[0], (char)(step == 2 ? c[1] : 0), 0 };
+                if (step == 2 && !c[1]) { printf("harness: %s:%d dangling sys token\n", path, lineno); fclose(f); return 1; }
+                int idx = token_index(who, tok);
+                if (idx < 0) { printf("harness: %s:%d unknown token %s=%s\n", path, lineno, who, tok); fclose(f); return 1; }
+                for (UINT32 fr = a; fr <= b && fr <= nScriptFrames; fr++)
+                    held[fr] |= (1u << idx);
+            }
+        }
+    }
+    fclose(f);
+    return 0;
+}
+
+// ── checksum ─────────────────────────────────────────────────────────────────
+// FNV-1a-64 over 68k-logical bytes, folded 8 bytes at a time exactly like the
+// MAME Lua side (string.unpack("<i8") == little-endian 64-bit lanes of the
+// logical byte stream).
+
+static UINT8* pHarnessFB = NULL;       // off-screen render target (video mode)
+static INT32 nHarnessFBLen = 0;
+
+static UINT64 fnv1a64_buf(const UINT8* p, INT32 len)
+{
+    UINT64 h = 0xcbf29ce484222325ULL;
+    const UINT64 prime = 0x100000001b3ULL;
+    for (INT32 i = 0; i < len; i++) h = (h ^ p[i]) * prime;
+    return h;
+}
+
+static UINT64 fnv1a64_workram()
+{
+    UINT64 h = 0xcbf29ce484222325ULL;
+    const UINT64 prime = 0x100000001b3ULL;
+    for (UINT32 off = 0; off < 0x10000; off += 8) {
+        UINT64 lane = 0;
+        for (int k = 7; k >= 0; k--)
+            lane = (lane << 8) | CpsRamFF[(off + k) ^ 1];  // ^1: SEK LE storage -> 68k logical
+        h = (h ^ lane) * prime;
+    }
+    return h;
+}
+
+// ── write tap with PC attribution (B5b, FBNEO_HTAP) ──────────────────────────
+// The MAME side has had "who wrote this address?" since M1 (trace_writes.lua /
+// tap_writes.lua); FBNeo had nothing, which mattered because FBNeo is the
+// PRIMARY target. Frontend-only: SekMapHandler + SekSetWrite*Handler are part
+// of the public 68k interface, so no emulation-core file is touched (Rule 1).
+//
+// Handler slot 7: the capcom drivers use 0-6 and SEK_MAXHANDLER is 10.
+//
+// The handler MUST write through faithfully or it corrupts the game. That is
+// not argued, it is gated: tests/test_fbneo_taps.sh requires a full replay
+// with the tap installed over work RAM to be checksum-identical to an
+// untapped run. A wrong write-through diverges immediately and loudly.
+//
+// FBNEO_HTAP="<start>-<end>[;<start>-<end>...]" (68k hex addresses)
+// FBNEO_HTAP_OUT=<path>   (default: <hout>.tap)
+// Log line: "<frame> <addr> <value> <B|W> pc=<pc>"
+
+#define HARNESS_TAP_SLOT 7
+#define HARNESS_TAP_MAX  8
+
+static UINT32 nTapLo[HARNESS_TAP_MAX], nTapHi[HARNESS_TAP_MAX];
+static int    nTapCount = 0;
+static FILE*  tapOut = NULL;
+
+static bool tap_hit(UINT32 a)
+{
+    for (int i = 0; i < nTapCount; i++)
+        if (a >= nTapLo[i] && a <= nTapHi[i]) return true;
+    return false;
+}
+
+// Write-through helpers. A 68k byte at address a lives at (offset ^ 1); a
+// 68k word at even address a therefore occupies host bytes [off] = low,
+// [off+1] = high, which on a little-endian host is a plain UINT16 store.
+static void harness_write_byte(UINT32 a, UINT8 d)
+{
+    UINT8* p = harness_mem(a);
+    if (p) *p = d;
+}
+static void harness_write_word(UINT32 a, UINT16 d)
+{
+    UINT8* hi = harness_mem(a);        // 68k high byte
+    UINT8* lo = harness_mem(a + 1);    // 68k low byte
+    if (hi) *hi = (UINT8)(d >> 8);
+    if (lo) *lo = (UINT8)(d & 0xFF);
+}
+
+static void __fastcall HarnessTapWriteByte(UINT32 a, UINT8 d)
+{
+    if (tapOut && tap_hit(a))
+        fprintf(tapOut, "%u %06x %02x B pc=%06x\n",
+                nHarnessFrame, a, d, (unsigned)SekGetPC(-1));
+    harness_write_byte(a, d);
+}
+
+static void __fastcall HarnessTapWriteWord(UINT32 a, UINT16 d)
+{
+    if (tapOut && tap_hit(a))
+        fprintf(tapOut, "%u %06x %04x W pc=%06x\n",
+                nHarnessFrame, a, d, (unsigned)SekGetPC(-1));
+    harness_write_word(a, d);
+}
+
+// Install over the PAGE-ALIGNED span covering the requested ranges. FBNeo
+// maps memory by page, so the handler necessarily sees a superset; tap_hit()
+// filters to the exact bytes asked for, and the write-through is identical
+// either way.
+static void harness_install_tap()
+{
+    const char* spec = getenv("FBNEO_HTAP");
+    if (!spec || !spec[0]) return;
+
+    char buf[1024]; snprintf(buf, sizeof(buf), "%s", spec);
+    UINT32 lo = 0xFFFFFFFF, hi = 0;
+    for (char* s = strtok(buf, ";"); s && nTapCount < HARNESS_TAP_MAX; s = strtok(NULL, ";")) {
+        UINT32 a0, a1;
+        if (sscanf(s, "%x-%x", &a0, &a1) != 2 || a1 < a0) {
+            printf("harness: bad FBNEO_HTAP range '%s'\n", s);
+            continue;
+        }
+        nTapLo[nTapCount] = a0; nTapHi[nTapCount] = a1; nTapCount++;
+        if (a0 < lo) lo = a0;
+        if (a1 > hi) hi = a1;
+    }
+    if (!nTapCount) return;
+
+    const char* outPath = getenv("FBNEO_HTAP_OUT");
+    char path[MAX_PATH + 16];
+    if (outPath && outPath[0]) snprintf(path, sizeof(path), "%s", outPath);
+    else                       snprintf(path, sizeof(path), "%s.tap", szHarnessOut);
+    tapOut = fopen(path, "w");
+    if (!tapOut) { printf("harness: cannot write %s\n", path); nTapCount = 0; return; }
+    fprintf(tapOut, "# frame addr value size pc  (68k-logical addresses)\n");
+
+    SekSetWriteByteHandler(HARNESS_TAP_SLOT, HarnessTapWriteByte);
+    SekSetWriteWordHandler(HARNESS_TAP_SLOT, HarnessTapWriteWord);
+    SekMapHandler(HARNESS_TAP_SLOT, lo & ~0xFFF, hi | 0xFFF, MAP_WRITE);
+    printf("harness: write tap on %d range(s), pages %06x-%06x -> %s\n",
+           nTapCount, lo & ~0xFFF, hi | 0xFFF, path);
+}
+
+// ── frame-scheduled pokes (B5b, FBNEO_HPOKE) ─────────────────────────────────
+// Mirrors POKES on the MAME side: "frame:addr:hexbytes;..." applied at the
+// START of the named frame, before it emulates.
+static void harness_apply_pokes(UINT32 frame)
+{
+    const char* spec = getenv("FBNEO_HPOKE");
+    if (!spec || !spec[0]) return;
+    char buf[4096]; snprintf(buf, sizeof(buf), "%s", spec);
+    for (char* s = strtok(buf, ";"); s; s = strtok(NULL, ";")) {
+        UINT32 fr, addr; char hex[512];
+        if (sscanf(s, "%u:%x:%511s", &fr, &addr, hex) != 3 || fr != frame) continue;
+        for (const char* h = hex; h[0] && h[1]; h += 2) {
+            unsigned v;
+            if (sscanf(h, "%2x", &v) != 1) break;
+            harness_write_byte(addr++, (UINT8)v);
+        }
+        printf("harness: poke frame %u @%06x = %s\n", fr, addr, hex);
+    }
+}
+
+// ── main loop ────────────────────────────────────────────────────────────────
+
+bool HarnessActive()
+{
+    return szHarnessInput[0] != 0;
+}
+
+int HarnessRun()
+{
+    if (!CpsRamFF) { printf("harness: not a CPS game (CpsRamFF null)\n"); return 1; }
+    if (resolve_inputs()) return 1;
+    if (parse_script(szHarnessInput)) return 1;
+
+    FILE* out = fopen(szHarnessOut[0] ? szHarnessOut : "harness_checksums.txt", "w");
+    if (!out) { printf("harness: cannot write %s\n", szHarnessOut); return 1; }
+
+    // determinism guards (see repo docs/GOTCHAS.md): no hiscore/cheat RAM
+    // writes, no runahead, fixed PRNG seed, no auto savestate (we never call
+    // RunInit/StatedAuto), no audio buffer (emulation-identical per qs.cpp).
+    EnableHiscores = 0;
+    bCheatsAllowed = 0;
+    bRunAhead = 0;
+    BurnRandomSetSeed(0x303808909313ULL);
+    pBurnSoundOut = NULL;
+
+    InputMake(true);  // one normal pass: writes constants + all-zero switches
+
+    // optional off-screen video (FBNEO_HVIDEO=<framebuffer checksum log>)
+    const char* szVideoOut = getenv("FBNEO_HVIDEO");
+    FILE* vout = NULL;
+    INT32 nVidW = 0, nVidH = 0;
+    if (szVideoOut && szVideoOut[0]) {
+        BurnDrvGetVisibleSize(&nVidW, &nVidH);
+        SetBurnHighCol(16);                 // fixed 16bpp: deterministic and
+        nBurnBpp = 2;                       // independent of any display setup
+        nBurnPitch = nVidW * nBurnBpp;
+        nHarnessFBLen = nVidW * nVidH * nBurnBpp;
+        pHarnessFB = (UINT8*)malloc(nHarnessFBLen);
+        memset(pHarnessFB, 0, nHarnessFBLen);
+        vout = fopen(szVideoOut, "w");
+        if (!vout) { printf("harness: cannot write %s\n", szVideoOut); return 1; }
+        fprintf(vout, "# framebuffer checksums %dx%d %dbpp\n", nVidW, nVidH, nBurnBpp * 8);
+        printf("harness: video on, %dx%d -> %s\n", nVidW, nVidH, szVideoOut);
+    }
+
+    harness_install_tap();   // FBNEO_HTAP (no-op unless set)
+
+    for (UINT32 f = 1; f <= nScriptFrames; f++) {
+        nHarnessFrame = f;
+        harness_apply_pokes(f);   // FBNEO_HPOKE (no-op unless set)
+
+        // scripted inputs for frame f, active while frame f emulates
+        UINT32 mask = held[f];
+        for (int t = 0; t < NTOKENS; t++)
+            *token_pval[t] = (mask >> t) & 1;
+
+        nFramesEmulated++;
+        nCurrentFrame++;
+        pBurnDraw = pHarnessFB;   // NULL unless video mode is on
+        BurnDrvFrame();
+
+        fprintf(out, "%u %016llx\n", f, (unsigned long long)fnv1a64_workram());
+        if (vout)
+            fprintf(vout, "%u %016llx\n", f,
+                    (unsigned long long)fnv1a64_buf(pHarnessFB, nHarnessFBLen));
+
+        if (szHarnessDumps[0]) {
+            char dumps[8192];
+            snprintf(dumps, sizeof(dumps), "%s", szHarnessDumps);
+            for (char* spec = strtok(dumps, ";"); spec; spec = strtok(NULL, ";")) {
+                UINT32 fr, first, last;
+                if (sscanf(spec, "%u:%x-%x", &fr, &first, &last) != 3 || fr != f)
+                    continue;
+                char path[MAX_PATH + 64];
+                snprintf(path, sizeof(path), "%s.dump_%u_%06x.bin",
+                         szHarnessOut, fr, first);
+                FILE* df = fopen(path, "wb");
+                // B5b: resolved by ADDRESS, so this now reaches OBJ RAM
+                // ($708000) and palette RAM ($900000) as well as work RAM.
+                // Unresolvable addresses write 0xFF rather than silently
+                // emitting work-RAM bytes for a region that is not work RAM.
+                for (UINT32 a2 = first; a2 <= last; a2++) {
+                    const UINT8* p = harness_mem(a2);
+                    fputc(p ? *p : 0xFF, df);   // 68k logical order
+                }
+                fclose(df);
+            }
+        }
+    }
+    // FBNEO_HGFX="<hexoff>-<hexend>[;...]": dump slices of the DECODED tile
+    // buffer. The RAM/framebuffer logs cannot answer "did the loader put the
+    // bytes where the address path expects them?" - this can, and it is the
+    // instrument the WIDE B4 investigation needed (also on the B5b list).
+    const char* szGfx = getenv("FBNEO_HGFX");
+    if (szGfx && szGfx[0] && CpsGfx) {
+        char spec[1024]; snprintf(spec, sizeof(spec), "%s", szGfx);
+        for (char* s = strtok(spec, ";"); s; s = strtok(NULL, ";")) {
+            UINT32 a0, a1;
+            if (sscanf(s, "%x-%x", &a0, &a1) != 2 || a1 < a0) continue;
+            if (a1 >= nCpsGfxLen) { printf("harness: gfx %08x-%08x beyond "
+                "nCpsGfxLen %08x\n", a0, a1, (unsigned)nCpsGfxLen); continue; }
+            char path[MAX_PATH + 64];
+            snprintf(path, sizeof(path), "%s.gfx_%08x.bin", szHarnessOut, a0);
+            FILE* gf = fopen(path, "wb");
+            if (!gf) continue;
+            fwrite(CpsGfx + a0, 1, a1 - a0 + 1, gf);
+            fclose(gf);
+            printf("harness: gfx dump %08x-%08x -> %s\n", a0, a1, path);
+        }
+    }
+
+    fprintf(out, "END %u\n", nScriptFrames);
+    fclose(out);
+    if (vout) { fprintf(vout, "END %u\n", nScriptFrames); fclose(vout); }
+    if (tapOut) { fprintf(tapOut, "END %u\n", nScriptFrames); fclose(tapOut); tapOut = NULL; }
+    if (pHarnessFB) { free(pHarnessFB); pHarnessFB = NULL; }
+    printf("harness: %u frames, log %s\n", nScriptFrames, szHarnessOut);
+    free(held);
+    return 0;
+}
diff --git a/src/burner/sdl/main.cpp b/src/burner/sdl/main.cpp
index 688404a..d8d8e65 100644
--- a/src/burner/sdl/main.cpp
+++ b/src/burner/sdl/main.cpp
@@ -38,6 +38,14 @@ const char* romname = NULL;
 
 extern void InitSupportPaths();
 
