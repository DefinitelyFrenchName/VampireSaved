{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent/hooks/pre_bash.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/settings.json)",
      "Edit(tools/agent/hooks/**)",
      "Edit(tools/agent/agentlib.py)"
    ]
  }
}
